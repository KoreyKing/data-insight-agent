# Provider-neutral OpenAI-compatible API (BYOM)
# Presets: openai, openrouter, deepseek, dashscope/qwen, kimi, zhipu/glm, gemini, ollama, vllm, custom
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=
# Optional: override provider preset. Required when LLM_PROVIDER=custom.
LLM_BASE_URL=
# Optional OpenRouter attribution headers.
LLM_HTTP_REFERER=
LLM_APP_TITLE=Data Insight Agent

# SMTP (for report email push)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=
SMTP_FROM=you@example.com

# Application metadata DB (default SQLite, inside data volume)
APP_DB_URL=sqlite:///./data/app.db

# Execution policy defaults (see docs/architecture.md §4)
EXEC_MAX_ROWS=10000
EXEC_SQL_TIMEOUT_S=30
EXEC_LLM_TIMEOUT_S=60
